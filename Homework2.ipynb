        "id": "IIsa_ifL69A7"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "x = float(input(\"Enter the coordinates x: \"))\n",
        "y = float(input(\"Enter the coordinates y: \"))\n",
        "ax, ay = 0, 0\n",
        "bx, by = 4, 4\n",
        "cx, cy = 6, 1\n",
        "\n",
        "# Вычисление проекций вектора по формуле ABx = Bx - Ax, ABy = By - Ay\n",
        "ab_x = bx - ax\n",
        "ab_y = by - ay\n",
        "ao_x = x - ax\n",
        "ao_y = y - ay\n",
        "# Вычисление псевдоскалярного произведения по формуле a ∧ b = a_x * b_y - a_y * b_x\n",
        "p = ab_x * ao_y - ab_y * ao_x\n",
        "\n",
        "bc_x = cx - bx\n",
        "bc_y = cy - by\n",
        "bo_x = x - bx\n",
        "bo_y = y - by\n",
        "p1 = bc_x * bo_y - bc_y * bo_y\n",
        "\n",
        "ca_x = ax - cx\n",
        "ca_y = ay - cy\n",
        "co_x = x - cx\n",
        "co_y = y - cy\n",
        "p2 = ca_x * co_y - ca_y * co_x\n",
        "\n",
        "if (p > 0 and p1 > 0 and p2 > 0) or (p < 0 and p1 < 0 and p2 < 0):\n",
        "  print(\"A point inside\")\n",
        "else:\n",
        "  print(\"A point is not inside\")\n",
        "\n",
        "\n",
        "\n"
      ],
      "metadata": {
