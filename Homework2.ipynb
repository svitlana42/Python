      "source": [
        "x = float(input(\"Enter the coordinates x: \"))\n",
        "y = float(input(\"Enter the coordinates y: \"))\n",
        "r = 4\n",
        "\n",
        "# По формуле O𝓍² + O𝓎² ≤ R²\n",
        "if x**2 + y**2 <= r**2:\n",
        "  print(\"A point inside the circle\")\n",
        "else:\n",
        "  print(\"A point not inside the circle\")"
      ],
      "metadata": {
