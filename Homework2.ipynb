      }
    },
    {
      "cell_type": "code",
      "source": [
        "floors = 9\n",
        "entrance = 4\n",
        "floor_flats = 4\n",
        "entrance1_flats = floors * floor_flats\n",
        "entrance4_flats = entrance1_flats * entrance\n",
        "flats = int(input(\"Apartment number: \"))\n",
        "\n",
        "if flats >= 1 and flats <= entrance4_flats:\n",
        "  # Номер подъезда\n",
        "  if flats <= entrance1_flats:\n",
        "    entrance_number = 1\n",
        "    local_flats = flats\n",
        "  elif flats <= entrance1_flats * 2:\n",
        "    entrance_number = 2\n",
        "    local_flats = flats - entrance1_flats\n",
        "  elif flats <= entrance1_flats * 3:\n",
        "    entrance_number = 3\n",
        "    local_flats = flats - (entrance1_flats * 2)\n",
        "  else:\n",
        "    entrance_number = 4\n",
        "    local_flats = flats - (entrance1_flats * 3)\n",
        "\n",
        "  # Номер этажа\n",
        "  if local_flats <= floor_flats:\n",
        "    floor_number = 1\n",
        "  elif local_flats <= floor_flats * 2:\n",
        "    floor_number = 2\n",
        "  elif local_flats <= floor_flats * 3:\n",
        "    floor_number = 3\n",
        "  elif local_flats <= floor_flats * 4:\n",
        "    floor_number = 4\n",
        "  elif local_flats <= floor_flats * 5:\n",
        "    floor_number = 5\n",
        "  elif local_flats <= floor_flats * 6:\n",
        "    floor_number = 6\n",
        "  elif local_flats <= floor_flats * 7:\n",
        "    floor_number = 7\n",
        "  elif local_flats <= floor_flats * 8:\n",
        "    floor_number = 8\n",
        "  else:\n",
        "    floor_number = 9\n",
        "\n",
        "  print(\"Entrance:\", entrance_number)\n",
        "  print(\"Floor:\", floor_number)\n",
        "\n",
        "else:\n",
        "  print(\"There is no such apartment\")\n"
      ],
